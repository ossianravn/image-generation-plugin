{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "image-generation": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/bin/image-generation.mjs", "serve"],
      "env": { "IMAGE_GENERATION_DATA": "${PLUGIN_DATA}" }
    }
  }
}
