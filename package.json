{
  "name": "@ossianravn/image-generation-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Local image generation and editing for agent hosts",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "bin": { "image-generation": "dist/cli.js" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.ts",
    "dev": "node --env-file-if-exists=.env.local src/cli.ts",
    "validate": "node scripts/validate.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:live": "node --env-file=.env.local scripts/live-check.ts"
  },
  "files": ["dist", "skills", "plugin.json", "mcp.json", "README.md", "docs", ".env.example"],
  "allowScripts": { "esbuild": true },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
